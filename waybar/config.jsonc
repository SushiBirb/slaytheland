{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 8,

    "modules-left": [
        "custom/princess",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "memory",
        "cpu",
        "custom/power"
    ],

    "custom/princess": {
        "format": "🗡️",
        "tooltip-format": "Slay the Princess - Click to Descend",
        "on-click": "wofi --show drun"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%A, %B %d  ·  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "BLADE {volume}%",
        "format-muted": "MUTED",
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "memory": {
        "format": "MEM {percentage}%",
        "interval": 3
    },

    "cpu": {
        "format": "HEART {usage}%",
        "interval": 3
    },

    "custom/power": {
        "format": "QUIT",
        "tooltip": "Leave the Cabin",
        "on-click": "hyprctl dispatch exit"
    }
}
